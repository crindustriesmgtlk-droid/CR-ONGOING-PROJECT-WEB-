    <div class="sc"><div class="sn">24<em>/7</em></div><div class="sl">Market Access</div></div>
    <div class="sc"><div class="sn">1<em>:500</em></div><div class="sl">Max Leverage</div></div>
  </div>

  <!-- MARKETS OVERVIEW (home) -->
  <section class="sec reveal">
    <div class="stag">What We Offer</div>
    <div class="stitle">Global Market Access</div>
    <p class="ssub">Trade across every major asset class with institutional execution and razor-thin spreads.</p>
