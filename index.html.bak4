        <div class="cr-ring r1"></div>
        <div class="cr-ring r2"></div>
        <div class="cr-ring r3"></div>
        <div class="od od1"></div><div class="od od2"></div><div class="od od3"></div>
        <span class="cf cf1">EUR/USD</span><span class="cf cf2">GBP/USD</span>
        <span class="cf cf3">XAU/USD</span><span class="cf cf4">BTC/USD</span>
        <span class="cf cf5">ETH</span><span class="cf cf6">USD/JPY</span>
        <!-- Price Cards -->
        <div class="pc pc1"><div class="pc-pair">EUR/USD</div><div class="pc-val" id="v-eur">1.1600</div><div class="pc-chg up" id="c-eur">▲ +0.18%</div></div>
        <div class="pc pc2"><div class="pc-pair">BTC/USD</div><div class="pc-val" id="v-btc">67,054</div><div class="pc-chg up" id="c-btc">▲ +1.24%</div></div>
        <div class="pc pc3"><div class="pc-pair">XAU/USD</div><div class="pc-val" id="v-gold">5,162</div><div class="pc-chg up" id="c-gold">▲ +0.65%</div></div>
        <div class="pc pc4"><div class="pc-pair">GBP/USD</div><div class="pc-val" id="v-gbp">1.3305</div><div class="pc-chg dn" id="c-gbp">▼ -0.09%</div></div>
        <div class="cr-hex"><svg viewBox="0 0 200 200" xmlns="http://www.w3.org/2000/svg">
          <defs>
            <linearGradient id="g1" x1="0%" y1="0%" x2="100%" y2="100%"><stop offset="0%" style="stop-color:#0d47a1"/><stop offset="50%" style="stop-color:#00b4d8"/><stop offset="100%" style="stop-color:#00e5ff"/></linearGradient>
            <linearGradient id="g2" x1="0%" y1="0%" x2="100%" y2="100%"><stop offset="0%" style="stop-color:#00e5ff"/><stop offset="100%" style="stop-color:#29b6f6"/></linearGradient>
            <filter id="glow"><feGaussianBlur stdDeviation="3" result="b"/><feMerge><feMergeNode in="b"/><feMergeNode in="SourceGraphic"/></feMerge></filter>
            <filter id="glow2"><feGaussianBlur stdDeviation="7" result="b"/><feMerge><feMergeNode in="b"/><feMergeNode in="SourceGraphic"/></feMerge></filter>
          </defs>
          <polygon points="100,8 178,52 178,148 100,192 22,148 22,52" fill="none" stroke="rgba(0,229,255,0.12)" stroke-width="1"><animateTransform attributeName="transform" type="rotate" from="0 100 100" to="360 100 100" dur="22s" repeatCount="indefinite"/></polygon>
          <polygon points="100,20 168,58 168,142 100,180 32,142 32,58" fill="rgba(3,10,28,0.96)" stroke="url(#g1)" stroke-width="2" filter="url(#glow)"/>
          <polygon points="100,36 154,66 154,134 100,164 46,134 46,66" fill="none" stroke="rgba(0,180,216,0.18)" stroke-width="1"><animateTransform attributeName="transform" type="rotate" from="0 100 100" to="-360 100 100" dur="14s" repeatCount="indefinite"/></polygon>
          <text x="100" y="112" text-anchor="middle" font-family="Orbitron,monospace" font-size="56" font-weight="900" fill="url(#g2)" filter="url(#glow2)" letter-spacing="-3">CR</text>
          <rect x="32" y="58" width="136" height="2" fill="rgba(0,229,255,0.08)" rx="1"><animate attributeName="y" from="58" to="140" dur="2.8s" repeatCount="indefinite"/><animate attributeName="opacity" values="0;0.7;0" dur="2.8s" repeatCount="indefinite"/></rect>
          <circle cx="100" cy="20" r="3.5" fill="#00e5ff" filter="url(#glow)"><animate attributeName="opacity" values="1;0.1;1" dur="2s" repeatCount="indefinite" begin="0s"/></circle>
          <circle cx="168" cy="58" r="3.5" fill="#00e5ff" filter="url(#glow)"><animate attributeName="opacity" values="1;0.1;1" dur="2s" repeatCount="indefinite" begin="0.33s"/></circle>
          <circle cx="168" cy="142" r="3.5" fill="#00e5ff" filter="url(#glow)"><animate attributeName="opacity" values="1;0.1;1" dur="2s" repeatCount="indefinite" begin="0.66s"/></circle>
          <circle cx="100" cy="180" r="3.5" fill="#00e5ff" filter="url(#glow)"><animate attributeName="opacity" values="1;0.1;1" dur="2s" repeatCount="indefinite" begin="1s"/></circle>
          <circle cx="32" cy="142" r="3.5" fill="#00e5ff" filter="url(#glow)"><animate attributeName="opacity" values="1;0.1;1" dur="2s" repeatCount="indefinite" begin="1.33s"/></circle>
          <circle cx="32" cy="58" r="3.5" fill="#00e5ff" filter="url(#glow)"><animate attributeName="opacity" values="1;0.1;1" dur="2s" repeatCount="indefinite" begin="1.66s"/></circle>
          <rect x="60" y="125" width="8" height="16" rx="1" fill="rgba(0,229,255,0.18)"/>
          <rect x="73" y="118" width="8" height="23" rx="1" fill="rgba(0,229,255,0.22)"/>
          <rect x="86" y="110" width="8" height="31" rx="1" fill="rgba(0,180,216,0.28)"/>
          <rect x="99" y="103" width="8" height="38" rx="1" fill="rgba(0,229,255,0.22)"/>
          <rect x="112" y="118" width="8" height="23" rx="1" fill="rgba(0,229,255,0.18)"/>
          <rect x="125" y="122" width="8" height="19" rx="1" fill="rgba(0,229,255,0.14)"/>
