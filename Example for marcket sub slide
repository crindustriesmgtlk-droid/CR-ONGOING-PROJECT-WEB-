                            script.setAttribute(attr.name, attr.value);
                        }
                    }

                    if (deferredScript.innerHTML) {
                        script.innerHTML = deferredScript.innerHTML;
                    }

                    deferredScript.parentNode.replaceChild(script, deferredScript);
                });
            }, 1000);
        </script>
    </body>
</html>
