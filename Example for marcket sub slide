                <script>
                    function navHandler(ev) {
                        const {parentNode, dataset} = ev.currentTarget;

                        parentNode.classList.toggle('nav-open');

                        navHandlerClose(ev);

                        const rootNode = document.querySelector('.nav-root');
                        const isActive = parentNode.classList.contains('nav-open');
                        rootNode.classList.toggle('active', isActive);

                        const item = isActive ? dataset.item : undefined;
                        const sizerRows = isActive ? Number(dataset.sizerRows) : 0;
                        const sizerTitles = isActive ? Number(dataset.sizerTitles) : 0;

                        rootNode.style.setProperty('--rows-count', sizerRows);
                        rootNode.style.setProperty('--titles-count', sizerTitles);
                        rootNode.style.setProperty('--spacing-count', sizerRows ? 2 : 0);

                        window['_nav_navHandler'] = {
                            item,
                            sizerRows,
                            sizerTitles,
                        };
                    }

                    function navHandlerClose(ev) {
                        const {parentNode} = ev.currentTarget;
                        const activeNodes = document.querySelectorAll('.nav-open');
                        activeNodes.forEach(node => {
                            if (parentNode !== node) {
                                node.classList.remove('nav-open');
                            }
                        }
                        );

                        const rootNode = document.querySelector('.nav-root');
                        rootNode.classList.remove('active');

                        window['_nav_navHandler'] = undefined;
                    }

                    function navHandlerRoot(ev) {
                        ev.stopPropagation();
                    }

                    document.addEventListener('DOMContentLoaded', function() {
                        const nodes = document.querySelectorAll('.nav-item');
                        nodes.forEach(node => {
                            node.addEventListener('click', navHandler);
                        }
                        );

                        window.addEventListener('click', navHandlerClose);

                        const rootNode = document.querySelector('.nav-root');
                        rootNode.addEventListener('click', navHandlerRoot);
                    });
                </script>
